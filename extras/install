#!/usr/bin/env bash

set -euo pipefail

SELF_PATH="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
BIN_DIR="${1:-${FOX_BIN_DIR:-${HOME}/.local/bin}}"

mkdir -p "${BIN_DIR}"

link_tool() {
    local source="$1"
    local name="$2"
    ln -sfn "${source}" "${BIN_DIR}/${name}"
    printf 'linked %s -> %s\n' "${BIN_DIR}/${name}" "${source}"
}

link_tool "${SELF_PATH}/apktool" apktool
link_tool "${SELF_PATH}/baksmali" baksmali
link_tool "${SELF_PATH}/smali" smali
link_tool "${SELF_PATH}/jadx-1.5.6/bin/jadx" jadx
link_tool "${SELF_PATH}/jadx-1.5.6/bin/jadx-gui" jadx-gui

printf '\nAdd this directory to PATH if it is not already present:\n  %s\n' "${BIN_DIR}"
