#!/usr/bin/env bash

set -euo pipefail

SOURCE="${BASH_SOURCE[0]}"
while [[ -h "${SOURCE}" ]]; do
    SOURCE_DIR="$(cd -P -- "$(dirname -- "${SOURCE}")" && pwd)"
    SOURCE="$(readlink -- "${SOURCE}")"
    [[ "${SOURCE}" != /* ]] && SOURCE="${SOURCE_DIR}/${SOURCE}"
done
SELF_PATH="$(cd -P -- "$(dirname -- "${SOURCE}")" && pwd)"
JAR="${SELF_PATH}/apktool_3.0.3.jar"

if [[ ! -r "${JAR}" ]]; then
    printf '%s: cannot find %s\n' "$(basename "$0")" "${JAR}" >&2
    exit 1
fi

JAVA_OPTS_DEFAULT=(-Xmx2g -Dfile.encoding=UTF-8)
JAVA_OPTS_EXTRA=()
while [[ "${1:-}" == -J* ]]; do
    JAVA_OPTS_EXTRA+=("-${1#-J}")
    shift
done

if ((${#JAVA_OPTS_EXTRA[@]})); then
    exec java "${JAVA_OPTS_DEFAULT[@]}" "${JAVA_OPTS_EXTRA[@]}" ${APKTOOL_OPTS:-} -jar "${JAR}" "$@"
else
    exec java "${JAVA_OPTS_DEFAULT[@]}" ${APKTOOL_OPTS:-} -jar "${JAR}" "$@"
fi
