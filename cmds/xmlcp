#!/usr/bin/env python3
"""Copy matching XML lines into companion resource XML files."""

from __future__ import annotations

import argparse
import re
from pathlib import Path


def insert_resource_line(target: Path, line: str) -> None:
    target.parent.mkdir(parents=True, exist_ok=True)
    if not target.exists():
        target.write_text(
            '<?xml version="1.0" encoding="utf-8"?>\n<resources>\n'
            f"{line}\n</resources>\n",
            encoding="utf-8",
        )
        return

    content = target.read_text(encoding="utf-8")
    match = re.search(r"(?m)^[ \t]*</resources>[ \t]*$", content)
    if match is None:
        raise ValueError(f"{target} has no </resources> closing tag")
    updated = f"{content[:match.start()]}{line}\n{content[match.start():]}"
    target.write_text(updated, encoding="utf-8")


def main() -> None:
    parser = argparse.ArgumentParser(
        description="Copy matching XML resource lines into suffixed destination XML files."
    )
    parser.add_argument("pattern", help="regular expression to search for")
    parser.add_argument("source_dir", type=Path)
    parser.add_argument("destination_dir", type=Path)
    parser.add_argument("suffix", help="suffix inserted before the .xml extension")
    args = parser.parse_args()

    expression = re.compile(args.pattern)
    for source in sorted(args.source_dir.rglob("*.xml")):
        lines = source.read_text(encoding="utf-8").splitlines()
        matches = [line for line in lines if expression.search(line)]
        if not matches:
            continue
        relative = source.relative_to(args.source_dir)
        destination_name = f"{source.stem}{args.suffix}{source.suffix}"
        destination = args.destination_dir / relative.parent / destination_name
        for line in matches:
            print(f"{source}: {line} -> {destination}")
            insert_resource_line(destination, line)


if __name__ == "__main__":
    main()
