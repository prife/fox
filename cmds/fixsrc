#!/usr/bin/env python3
"""Improve selected JADX Java literals using current Android constant maps."""

from __future__ import annotations

import argparse
import re
import sys
from pathlib import Path


SCRIPT_DIR = Path(__file__).resolve().parent


def load_string_map(filename: str) -> dict[str, str]:
    mapping: dict[str, str] = {}
    for raw_line in (SCRIPT_DIR / filename).read_text(encoding="utf-8").splitlines():
        line = raw_line.strip()
        if not line or line.startswith("#"):
            continue
        key, value = line.split(":", 1)
        mapping[key] = value
    return mapping


def load_flag_map(filename: str) -> dict[int, str]:
    mapping: dict[int, str] = {}
    for raw_line in (SCRIPT_DIR / filename).read_text(encoding="utf-8").splitlines():
        line = raw_line.strip()
        if not line or line.startswith("#"):
            continue
        key, value = line.split(":", 1)
        number = int(key, 0)
        # Android reuses several flag bits across distinct APIs. Intent flag
        # aliases may be ACTION/RECEIVER/GRANT-specific; preserve activity
        # names first because this fixer targets Intent#setFlags/addFlags.
        current = mapping.get(number)
        is_activity = value.startswith("Intent.FLAG_ACTIVITY_")
        is_receiver = value.startswith("Intent.FLAG_RECEIVER_")
        current_is_activity = current is not None and current.startswith("Intent.FLAG_ACTIVITY_")
        current_is_receiver = current is not None and current.startswith("Intent.FLAG_RECEIVER_")
        if current is None or (is_activity and not current_is_activity) or (
            not is_receiver and current_is_receiver
        ):
            mapping[number] = value
    return mapping


def quoted_replacement(mapping: dict[str, str], source: str) -> str:
    if not mapping:
        return source
    pattern = re.compile(
        "|".join(re.escape(key) for key in sorted(mapping, key=len, reverse=True))
    )
    return pattern.sub(lambda match: mapping[match.group(0)], source)


def format_flags(value: int, mapping: dict[int, str]) -> str:
    if value == 0 and 0 in mapping:
        return mapping[0]

    remaining = value & 0xFFFFFFFF
    pieces: list[str] = []
    candidates = sorted(
        (
            bit
            for bit in mapping
            if bit != 0
            and (bit & 0xFFFFFFFF).bit_count() == 1
            and (remaining & (bit & 0xFFFFFFFF)) == (bit & 0xFFFFFFFF)
        ),
        key=lambda bit: bit & 0xFFFFFFFF,
        reverse=True,
    )
    for bit in candidates:
        if bit == 0:
            continue
        unsigned_bit = bit & 0xFFFFFFFF
        pieces.append(mapping[bit])
        remaining &= ~unsigned_bit

    if not pieces:
        return f"0x{value & 0xFFFFFFFF:08x}"
    if remaining:
        pieces.append(f"0x{remaining:08x}")
    return " | ".join(pieces)


def replace_numeric_argument(
    source: str, pattern: str, mapping: dict[int, str], *, table: bool = False
) -> str:
    expression = re.compile(pattern)

    def replace(match: re.Match[str]) -> str:
        raw_value = match.group("value")
        try:
            value = int(raw_value, 0)
        except ValueError:
            return match.group(0)

        if table:
            replacement = mapping.get(value)
            if replacement is None:
                return match.group(0)
        else:
            replacement = format_flags(value, mapping)
        return match.group(0).replace(raw_value, replacement, 1)

    return expression.sub(replace, source)


def fix_source(source: str) -> str:
    intent_actions = load_string_map("intent_action.txt")
    context_services = load_string_map("context_service.txt")
    intent_flags = load_flag_map("intent_flag.txt")
    visibility_flags = load_flag_map("visibility_flag.txt")
    window_flags = load_flag_map("window_lp_flag.txt")

    source = quoted_replacement(intent_actions, source)
    source = quoted_replacement(context_services, source)
    source = replace_numeric_argument(
        source,
        r"\.setVisibility\(\s*(?P<value>[-+]?(?:0[xX][0-9a-fA-F]+|\d+))\s*\)",
        visibility_flags,
        table=True,
    )
    source = replace_numeric_argument(
        source,
        r"\.(?:setFlags|addFlags)\(\s*(?P<value>[-+]?(?:0[xX][0-9a-fA-F]+|\d+))\s*\)",
        intent_flags,
    )
    source = replace_numeric_argument(
        source,
        r"\b(?:lp|mWLayoutParams)\.flags\s*(?:=|\|=)\s*(?P<value>[-+]?(?:0[xX][0-9a-fA-F]+|\d+))",
        window_flags,
    )
    return source


def process_file(path: Path, dry_run: bool) -> bool:
    original = path.read_text(encoding="utf-8")
    updated = fix_source(original)
    if updated == original:
        return False
    if not dry_run:
        path.write_text(updated, encoding="utf-8")
    return True


def main() -> None:
    parser = argparse.ArgumentParser(
        description="Replace selected Android literals in JADX Java sources."
    )
    parser.add_argument("--dry-run", action="store_true", help="report changed files only")
    parser.add_argument(
        "files",
        nargs="+",
        type=Path,
        help="Java files or directories; directories are searched recursively",
    )
    args = parser.parse_args()

    targets: list[Path] = []
    for item in args.files:
        if item.is_dir():
            targets.extend(sorted(item.rglob("*.java")))
        elif item.is_file():
            targets.append(item)
        else:
            print(f"fixsrc: ignoring missing path: {item}", file=sys.stderr)

    changed = 0
    for path in targets:
        if process_file(path, args.dry_run):
            changed += 1
            print(path)
    print(f"fixsrc: {'would update' if args.dry_run else 'updated'} {changed} file(s)")


if __name__ == "__main__":
    main()
