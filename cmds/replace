#!/usr/bin/env bash

set -euo pipefail

usage() {
    printf 'usage: replace <source-dir> <destination-dir>\n' >&2
    exit 1
}

(($# == 2)) || usage

source_dir="$(cd -- "$1" && pwd -P)"
destination_dir="$2"
mkdir -p "${destination_dir}"
destination_dir="$(cd -- "${destination_dir}" && pwd -P)"

while IFS= read -r -d '' source_file; do
    relative_path="${source_file#"${source_dir}"/}"
    destination_file="${destination_dir}/${relative_path}"
    destination_parent="$(dirname -- "${destination_file}")"
    base_name="$(basename -- "${source_file%.*}")"

    mkdir -p "${destination_parent}"
    while IFS= read -r -d '' conflict; do
        [[ "${conflict}" == "${destination_file}" ]] && continue
        printf 'remove conflicting file: %s\n' "${conflict}"
        rm -f -- "${conflict}"
    done < <(find "${destination_parent}" -maxdepth 1 -type f -name "${base_name}.*" -print0)

    printf '%s -> %s\n' "${source_file}" "${destination_file}"
    cp -- "${source_file}" "${destination_file}"
done < <(find "${source_dir}" -type f -print0)
