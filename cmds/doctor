#!/usr/bin/env bash

set -euo pipefail

SELF_PATH="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
FOX_ROOT="$(cd -- "${SELF_PATH}/.." && pwd -P)"
EXTRAS="${FOX_ROOT}/extras"

failures=0

check() {
    local label="$1"
    shift
    if "$@"; then
        printf '[ok] %s\n' "${label}"
    else
        printf '[!!] %s\n' "${label}" >&2
        failures=$((failures + 1))
    fi
}

check "Java 11+ is available" bash -c '
    version=$(java -version 2>&1 | sed -n "1s/.*version \"\\([0-9][0-9]*\\).*/\\1/p")
    test -n "$version" && test "$version" -ge 11
'

check "JADX bundle exists" test -x "${EXTRAS}/jadx-1.5.6/bin/jadx"
check "Apktool bundle exists" test -r "${EXTRAS}/apktool_3.0.3.jar"
check "Smali Android 16 build exists" test -r "${EXTRAS}/smali-3.0.9-android16.jar"
check "Baksmali Android 16 build exists" test -r "${EXTRAS}/baksmali-3.0.9-android16.jar"

if ((failures == 0)); then
    printf '\nTool versions:\n'
    java -version 2>&1 | head -n 1
    "${EXTRAS}/jadx-1.5.6/bin/jadx" --version
    "${EXTRAS}/apktool" --version
    "${EXTRAS}/smali" --version | head -n 1
    "${EXTRAS}/baksmali" --version | head -n 1
    printf '\nAndroid targets: API 35 (Android 15) and API 36 (Android 16)\n'
fi

exit "${failures}"
